<Window x:Class="Pinlist.Desktop.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinlist" Icon="Assets/pinlist.ico" Width="420" Height="400"
        MinWidth="340" MinHeight="300" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Border Background="#FF1B1D22" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeadingText" Text="{DynamicResource Text.NewTask}" Foreground="#F4F5F7" FontSize="18" FontWeight="SemiBold"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource HeaderButton}" Click="Cancel_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource Text.TitleLabel}" Foreground="#737985" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource EditorTextBox}" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Text.Details}" Foreground="#737985" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <TextBox x:Name="ContextBox" Grid.Row="1" Style="{StaticResource EditorTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LowUrgency" Content="{DynamicResource Text.Low}" GroupName="Urgency" Style="{StaticResource UrgencySegment}"/>
                    <RadioButton x:Name="NormalUrgency" Content="{DynamicResource Text.Normal}" GroupName="Urgency" Style="{StaticResource UrgencySegment}" Margin="6,0,0,0"/>
                    <RadioButton x:Name="HighUrgency" Content="{DynamicResource Text.Urgent}" GroupName="Urgency" Style="{StaticResource UrgencySegment}" Margin="6,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="PinnedBox" Grid.Column="1" Content="{DynamicResource Text.Important}" Foreground="#C6CBD5" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText" Foreground="#F08B82" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DoneButton" Content="{DynamicResource Text.MarkDone}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="Done_Click"/>
                    <Button Content="{DynamicResource Text.Cancel}" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Content="{DynamicResource Text.AddTask}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

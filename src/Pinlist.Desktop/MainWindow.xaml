<Window x:Class="Pinlist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinlist" Icon="Assets/pinlist.ico" Width="360" Height="560" MinWidth="320" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Topmost="False" ShowInTaskbar="False" Opacity="0.72"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        >
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}"
                        Executed="EditTaskCommand_Executed" />
    </Window.CommandBindings>
    <Border x:Name="RootBorder" Background="#FA17181B" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="30" Height="30" Source="Assets/pinlist-icon.png" Stretch="Uniform"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pinlist" Foreground="#F4F5F7" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OpenCountText" Foreground="#7F858F" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="AlwaysOnTopButton" ToolTip="{DynamicResource Text.AlwaysOnTopOff}"
                            Style="{StaticResource HeaderButton}" Click="AlwaysOnTop_Click">
                        <Viewbox Width="16" Height="16" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox.RenderTransform>
                                <TranslateTransform Y="1.5"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,2.5 L11,2.5 M6.5,2.5 L6.5,6.3 L4.5,8.5 L11.5,8.5 L9.5,6.3 L9.5,2.5 M8,8.5 L8,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="{DynamicResource Text.AddTask}" Foreground="#DDE3FF" Style="{StaticResource HeaderButton}" Click="AddTask_Click">
                        <Path Data="M8,3 L8,13 M3,8 L13,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="CollapseButton" ToolTip="{DynamicResource Text.Collapse}" Style="{StaticResource HeaderButton}" Click="Collapse_Click">
                        <Path x:Name="CollapseIcon" Data="M3,10 L8,5 L13,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button ToolTip="{DynamicResource Text.CloseToTray}" Style="{StaticResource HeaderButton}" Click="Close_Click">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
            <ListBox x:Name="TaskList" Grid.Row="1" Margin="12,4,12,12" Background="Transparent" BorderThickness="0"
                     Foreground="#F5F7FA" AllowDrop="True" PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="TaskList_PreviewMouseMove" DragOver="TaskList_DragOver" DragLeave="TaskList_DragLeave"
                     Drop="TaskList_Drop" MouseDoubleClick="TaskList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Text.Edit}" Command="{x:Static ApplicationCommands.Properties}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="DropTarget" Background="Transparent" CornerRadius="10"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="DropTarget" Property="Background" Value="#224D7CFE"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DropTarget" Property="Background" Value="#184D7CFE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TaskCard" Background="#08FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="10,9" Cursor="Hand"
                                ToolTipService.InitialShowDelay="280" ToolTipService.ShowDuration="60000">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource TaskDetailToolTip}"
                                         Placement="Mouse" HorizontalOffset="14" VerticalOffset="10">
                                    <Border Background="#FF24272E" BorderBrush="#3D8FA8FF" BorderThickness="1"
                                            CornerRadius="10" Padding="14" MaxWidth="420">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#F5F7FA" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{DynamicResource Text.Details}" Foreground="#8FA8FF"
                                                       FontSize="10" FontWeight="SemiBold" Margin="0,11,0,5"/>
                                            <TextBlock Text="{Binding Context, Converter={StaticResource TaskContextDisplayConverter}}"
                                                       Foreground="#CDD2DC" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <Button Tag="{Binding}" ToolTip="{DynamicResource Text.MarkComplete}" Style="{StaticResource HeaderButton}" Width="28" Height="28"
                                        Click="CompleteTask_Click">
                                    <Grid Width="16" Height="16">
                                        <Ellipse Stroke="#707783" StrokeThickness="1.4"/>
                                        <Path Data="M3.5,8 L6.5,11 L12.5,4.8" Stroke="#8FA8FF" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Closed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{Binding Urgency, Converter={StaticResource UrgencyBrushConverter}}"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#EFF0F3" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Closed"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Context}" Foreground="#777D87" FontSize="11.5" Margin="14,4,0,0"
                                               MaxHeight="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Tag="{Binding}" ToolTip="{DynamicResource Text.ToggleImportant}"
                                        Width="28" Height="28" Click="ImportantTask_Click">
                                    <Path Data="M5,3 L12.5,3 L10.5,7 L12.5,11 L5,11 M5,2 L5,14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HeaderButton}">
                                            <Setter Property="Foreground" Value="#656C77"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Foreground" Value="#F0B85B"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#204D7CFE"/>
                                            <Setter Property="BorderBrush" Value="#668FA8FF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Closed"><Setter Property="Opacity" Value="0.48"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="0,0,0,34" IsHitTestVisible="False">
                <Border Width="44" Height="44" Background="#0AFFFFFF" CornerRadius="14"
                        HorizontalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#69707C" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource Text.NothingPending}" Foreground="#8A909A" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="{DynamicResource Text.AddHint}" Foreground="#555B64" FontSize="10.5"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
            <Border x:Name="UndoBar" Grid.Row="1" Panel.ZIndex="5" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16"
                    Background="#F52A2D34" BorderBrush="#2FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UndoText" Foreground="#D9DDE5" FontSize="11.5" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Text.Undo}" Style="{StaticResource HeaderButton}" Width="46" Height="26" Margin="8,0,0,0"
                            Foreground="#9EB2FF" Click="Undo_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="Pinlist.Desktop.TaskHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History &amp; Trash" Icon="Assets/pinlist.ico" Width="430" Height="500"
        MinWidth="360" MinHeight="360" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Border Background="#FF1B1D22" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="History &amp; Trash" Foreground="#F4F5F7" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Completed and removed tasks" Foreground="#747B86" FontSize="10.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource HeaderButton}" Click="Close_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                </Button>
            </Grid>
            <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#09FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="9" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#D7DAE0" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#707782" FontSize="10.5" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding}" Content="Restore" Style="{StaticResource SecondaryButton}" Click="Restore_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No completed or removed tasks" Foreground="#737A85"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#F08B82" FontSize="11" Margin="2,8,0,0"/>
        </Grid>
    </Border>
</Window>
